{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "game-backend-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",

  // 房间对象和玩家对象，都使用 SQLite 存储。
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "PLAYER", "class_name": "Player" },
      { "name": "IDENTITY", "class_name": "Identity" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  "exports": {
    "Room": { "type": "durable-object", "storage": "sqlite" },
    "Player": { "type": "durable-object", "storage": "sqlite" },
    "Identity": { "type": "durable-object", "storage": "sqlite" },
    "Matchmaker": { "type": "durable-object", "storage": "sqlite" }
  },

  // 运营配置和好友房的短码。没有填 id：第一次发布时由 wrangler 创建。
  "kv_namespaces": [{ "binding": "CONFIG" }],

  // 定时任务：每 5 分钟一次的例行检查，和每天一次的清理（UTC 时间）。
  "triggers": { "crons": ["*/5 * * * *", "0 19 * * *"] },

  // 指标：匹配等待时长、结算、定时任务耗时等，写进 Analytics Engine。
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "game_metrics" }],

  // 对局记录和录像。没有填 database_id：第一次发布时由 wrangler 创建并把 ID 写回这个文件。
  "d1_databases": [{ "binding": "DB", "database_name": "game-example", "migrations_dir": "migrations" }],

  // 房间把对局记录送进队列，同一个 Worker 的 queue 处理函数负责写进 D1。
  "queues": {
    "producers": [
      { "binding": "MATCH_LOG", "queue": "match-log" },
      // 玩家对象对外的通知：分数变化、好友、邀请。
      { "binding": "PLAYER_EVENTS", "queue": "player-events" }
    ],
    "consumers": [
      {
        "queue": "match-log",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "match-log-dlq"
      },
      {
        "queue": "player-events",
        "max_batch_size": 50,
        // 好友申请要尽快到对方那里，所以只攒 1 秒。
        "max_batch_timeout": 1,
        "max_retries": 10,
        "dead_letter_queue": "player-events-dlq"
      },
      // 死信队列也要有人消费：记日志、存表。否则消息只是换了个地方躺着，过期后照样丢。
      { "queue": "match-log-dlq", "max_batch_size": 10, "max_batch_timeout": 5 },
      { "queue": "player-events-dlq", "max_batch_size": 10, "max_batch_timeout": 5 }
    ]
  },

  // 必须存在的密钥。本地从 .dev.vars 读取，线上用 wrangler secret put 设置，缺少时发布会失败。
  "secrets": {
    "required": [
      "SESSION_SECRET",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "GA_API_SECRET",
      "TURNSTILE_SECRET"
    ]
  },

  // 登录接口的限流：同一个来源地址在一个节点上每分钟大约 20 次。
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    // 下面三个是第 11 章加的：按玩家限制敏感接口和普通写入，按来源地址限制第三方回调。
    { "name": "SENSITIVE_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1005", "simple": { "limit": 120, "period": 60 } },
    { "name": "WEBHOOK_LIMITER", "namespace_id": "1007", "simple": { "limit": 120, "period": 60 } }
  ],

  // 联调用的最小客户端，作为静态资源一起发布。
  "assets": { "directory": "../client" },

  // 日志全量保留；追踪打开后，请求经过的每一次对象调用、数据库查询都会被自动记录。
  "observability": { "enabled": true, "traces": { "enabled": true } },

  // ACCESS_* 是管理后台用的 Cloudflare Access 应用的信息，不是密钥。留空时管理接口全部不可用。
  // TURNSTILE_ENFORCE 设为 "true" 时，创建新的游客账号要先通过人机验证。上线前打开。
  // GA_MEASUREMENT_ID 是 Firebase 里网页数据流的衡量 ID（G- 开头），不是密钥。留空时服务端不补报付款事件。
  "vars": { "ENVIRONMENT": "production", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "", "GA_MEASUREMENT_ID": "", "TURNSTILE_ENFORCE": "false" },

  "env": {
    "staging": {
      "name": "game-backend-example-staging",
      // 绑定和变量不会被环境继承，必须在每个环境里重新声明。
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "Room" },
          { "name": "PLAYER", "class_name": "Player" },
          { "name": "IDENTITY", "class_name": "Identity" },
          { "name": "MATCHMAKER", "class_name": "Matchmaker" }
        ]
      },
      "d1_databases": [{ "binding": "DB", "database_name": "game-example-staging", "migrations_dir": "migrations" }],
      "queues": {
        "producers": [
          { "binding": "MATCH_LOG", "queue": "match-log-staging" },
          { "binding": "PLAYER_EVENTS", "queue": "player-events-staging" }
        ],
        "consumers": [
          {
            "queue": "match-log-staging",
            "max_batch_size": 50,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "match-log-staging-dlq"
          },
          {
            "queue": "player-events-staging",
            "max_batch_size": 50,
            "max_batch_timeout": 1,
            "max_retries": 10,
            "dead_letter_queue": "player-events-staging-dlq"
          },
          { "queue": "match-log-staging-dlq", "max_batch_size": 10, "max_batch_timeout": 5 },
          { "queue": "player-events-staging-dlq", "max_batch_size": 10, "max_batch_timeout": 5 }
        ]
      },
      "secrets": {
        "required": [
          "SESSION_SECRET",
          "TELEGRAM_BOT_TOKEN",
          "TELEGRAM_WEBHOOK_SECRET",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET",
          "GA_API_SECRET",
          "TURNSTILE_SECRET"
        ]
      },
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
        { "name": "SENSITIVE_LIMITER", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "1006", "simple": { "limit": 120, "period": 60 } },
        { "name": "WEBHOOK_LIMITER", "namespace_id": "1008", "simple": { "limit": 120, "period": 60 } }
      ],
      "kv_namespaces": [{ "binding": "CONFIG" }],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "game_metrics_staging" }],
      "triggers": { "crons": ["*/5 * * * *", "0 19 * * *"] },
      "vars": { "ENVIRONMENT": "staging", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "", "GA_MEASUREMENT_ID": "", "TURNSTILE_ENFORCE": "false" }
    }
  }
}
